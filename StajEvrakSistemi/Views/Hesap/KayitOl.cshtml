<div class="container mt-5" style="max-width: 420px;">
    <div class="card p-4 shadow-sm">
        <h3 class="text-center mb-3">Yeni Öğrenci Kaydı</h3>
        @if(ViewBag.Hata != null) { <div class="alert alert-danger">@ViewBag.Hata</div> }
        <form method="post" action="/Hesap/KayitOl">
            <div class="mb-3">
                <label class="form-label">Öğrenci Numarası</label>
                <input type="text" name="kullaniciAdi" class="form-control" placeholder="Örn: 220202005" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input type="text" name="adSoyad" class="form-control" placeholder="Adınız Soyadınız" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Şifre Belirleyin</label>
                <input type="password" name="sifre" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Hesap Oluştur</button>
        </form>
        <div class="text-center mt-3">
            <a href="/Hesap/Giris">Giriş Ekranına Dön</a>
        </div>
    </div>
</div>