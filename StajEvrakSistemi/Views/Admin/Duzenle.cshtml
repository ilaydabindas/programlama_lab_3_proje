@model StajEvrakSistemi.Models.StajBasvurusu

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm p-4">
        <h3 class="text-center mb-4">Başvuru İnceleme ve Düzenleme</h3>
        <form method="post" action="/Admin/Duzenle">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div class="mb-3">
                <label class="form-label">Öğrenci Numarası</label>
                <input type="text" class="form-control" value="@Model.OgrenciNo" disabled />
            </div>
            
            <div class="mb-4">
                <label class="form-label fw-bold">Evrak / Başvuru Statüsü</label>
                <select name="statu" class="form-select">
                    <option value="Bekliyor" selected="@(Model.Statu == "Bekliyor")">Bekliyor</option>
                    <option value="Onaylandı" selected="@(Model.Statu == "Onaylandı")">Onaylandı</option>
                    <option value="Reddedildi" selected="@(Model.Statu == "Reddedildi")">Reddedildi</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Yüklenen Staj Evrakı</label>
                <div class="d-grid">
                    <a href="/Admin/EvrakIndir?ogrenciNo=@Model.OgrenciNo" target="_blank" class="btn btn-outline-info btn-lg">
                        📄 Evrakı Görüntüle / İndir
                    </a>
                </div>
                <div class="form-text mt-2">Evrak yeni bir sekmede PDF olarak açılacaktır. İnceledikten sonra aşağıdan onay/red işlemini yapabilirsiniz.</div>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="/Admin/Index" class="btn btn-secondary">İptal</a>
                <button type="submit" class="btn btn-success">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>
