@model List<StajEvrakSistemi.Models.StajBasvurusu>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Admin Paneli - Başvuru Listesi</h2>
        <a href="/Hesap/Cikis" class="btn btn-outline-danger">Sistemden Çıkış Yap</a>
    </div>

    <!-- Başarı Bildirimi -->
    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Başarılı!</strong> @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- Hata Bildirimi -->
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <strong>Hata:</strong> @TempData["Hata"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- Test Veri Seti Yükleme Alanı -->
    <div class="card shadow-sm mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Test Veri Seti Yükle</h5>
        </div>
        <div class="card-body">
            <!-- Dosya yükleme olduğu için enctype="multipart/form-data" kullanılması zorunludur -->
            <form action="/Admin/VeriSetiYukle" method="post" enctype="multipart/form-data" class="d-flex align-items-center">
                <input type="file" name="veriSeti" class="form-control me-3" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" required>
                <button type="submit" class="btn btn-success text-nowrap">Veri Setini İçe Aktar</button>
            </form>
            <small class="text-muted mt-2 d-block">
                * Proje dokümanında belirtilen test veri setini (.csv veya .xlsx) buradan sisteme aktarabilirsiniz.
            </small>
        </div>
    </div>
    
    <!-- Başvuru Tablosu -->
    <div class="card shadow-sm p-4">
        <h4 class="mb-3">Sistemdeki Tüm Başvurular</h4>
        <table class="table table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model) {
                    <tr>
                        <td class="align-middle">@item.OgrenciNo</td>
                        <td class="align-middle">@item.AdSoyad</td>
                        <td class="align-middle">
                            <!-- Duruma göre dinamik renkli rozetler -->
                            <span class="badge @(item.Statu == "Onaylandı" ? "bg-success" : (item.Statu == "Reddedildi" ? "bg-danger" : "bg-warning text-dark"))">
                                @item.Statu
                            </span>
                        </td>
                        <td>
                            <a href="/Admin/Duzenle/@item.Id" class="btn btn-sm btn-primary">İncele/Düzenle</a>
                            <!-- Silme işleminde yanlışlığı önlemek için onay penceresi -->
                            <a href="/Admin/Sil/@item.Id" class="btn btn-sm btn-danger ms-2" onclick="return confirm('Bu başvuruyu silmek istediğinize emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
