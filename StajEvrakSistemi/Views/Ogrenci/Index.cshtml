@model StajEvrakSistemi.Models.StajBasvurusu

<div class="container mt-4" style="max-width: 750px;">
    
    <!-- Üst Kısım: Sayfa Başlığı ve Çıkış Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-bold text-secondary">Öğrenci Paneli</h4>
        <a href="/Hesap/Cikis" class="btn btn-danger shadow-sm">Çıkış Yap</a>
    </div>

    <!-- Başarı veya Hata Bildirimleri -->
    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Hata"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null)
    {
        <!-- Öğrenci daha önce başvuru yaptıysa durum kartı gösterilir -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0">Staj Başvuru Durumunuz</h5>
            </div>
            <div class="card-body p-4">
                
                <!-- Dokümana Uygun Başvuru Statüsü -->
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <strong class="me-3 fs-5">Durum:</strong>
                    @if (Model.Statu == "Onaylandı")
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">Onaylandı</span>
                    }
                    else if (Model.Statu == "Hatalı / Eksik" || Model.Statu == "Reddedildi")
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2">Hatalı / Eksik</span>
                    }
                    else if (Model.Statu == "Tamamlandı")
                    {
                        <span class="badge bg-info text-dark fs-6 px-3 py-2">Tamamlandı</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">@Model.Statu</span>
                    }
                </div>

                <!-- Detaylı Bilgiler (Tüm Alanlar Eklendi) -->
                <h6 class="fw-bold mb-3 text-secondary">Başvuru Detayları</h6>
                
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Öğrenci Numarası:</div><div class="col-sm-8">@Model.OgrenciNo</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Ad Soyad:</div><div class="col-sm-8">@Model.AdSoyad</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">TC Kimlik No:</div><div class="col-sm-8">@Model.TcKimlik</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Uyruk / Doğum Trh:</div><div class="col-sm-8">@Model.Uyruk / @Model.DogumTarihi</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Okuduğu Bölüm:</div><div class="col-sm-8">@Model.OkuduguBolum</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">İletişim:</div><div class="col-sm-8">@Model.Telefon <br/> @Model.Eposta</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Açık Adres:</div><div class="col-sm-8">@Model.Adres</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Evrak Teslim Yılı:</div><div class="col-sm-8">@Model.TeslimYili</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Önceki Staj (Gün):</div><div class="col-sm-8">@Model.OncekiStajGunSayisi</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Sağlık Yardımı:</div><div class="col-sm-8">@Model.SaglikYardimiStatusu</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Staj Tarihleri:</div><div class="col-sm-8">@Model.BaslangicTarihi - @Model.BitisTarihi</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Staj Günleri:</div><div class="col-sm-8">@Model.StajGunleri</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 fw-bold">Mühendis Sayısı:</div>
                    <div class="col-sm-8">
                        @Model.MuhendisSayisi 
                        @(Model.MuhendisSayisi < 5 && !string.IsNullOrEmpty(Model.MuhendisBolumu) ? $" ({Model.MuhendisBolumu})" : "")
                    </div>
                </div>


                <!-- ALT BİLGİLENDİRMELER -->
                @if (Model.Statu == "İnceleniyor" || Model.Statu == "Bekliyor")
                {
                    <div class="alert alert-info mb-0">
                        Başvurunuz komisyon tarafından incelenmektedir. Durum güncellendiğinde bu ekrandan takip edebilirsiniz.
                    </div>
                }
                
    @if (Model.Statu != "Tamamlandı")
    {
        <div class="mt-4">
            <a href="/Ogrenci/EvrakYukle" class="btn btn-warning">
                Başvuruyu Güncelle
            </a>
            <small class="d-block text-muted mt-2">
                * Başvurunuz "Tamamlandı" statüsüne geçene kadar bilgilerinizi düzeltip yeni evrak yükleyebilirsiniz.
            </small>
        </div>
    }
                else if (Model.Statu == "Hatalı / Eksik" || Model.Statu == "Reddedildi")
                {
                    <div class="alert alert-danger border-danger mb-0">
                        <h6 class="alert-heading fw-bold">Başvurunuz Hatalı / Eksik</h6>
                        <p class="mb-3">Staj evrakınızda eksiklik veya hata tespit edilmiştir. Lütfen bilgilerinizi ve evrakınızı güncelleyerek tekrar gönderiniz.</p>
                        
                        <a href="/Ogrenci/EvrakYukle" class="btn btn-danger w-100 fw-bold">Evrakları ve Bilgileri Tekrar Yükle</a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Başvurusu bulunmayan öğrenciye gösterilen ekran -->
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body p-5 text-center">
                <h5 class="text-secondary mb-4">Sistemde kayıtlı bir staj başvurunuz bulunmamaktadır.</h5>
                <p class="text-muted mb-4">Staj sürecinizi başlatmak için Ek-16 bilgilerinizi doldurmalı ve evrakınızı yüklemelisiniz.</p>
                
                <a href="/Ogrenci/EvrakYukle" class="btn btn-primary btn-lg px-4 shadow">
                    Yeni Staj Başvurusu Yap (Evrak Yükle)
                </a>
            </div>
        </div>
    }
</div>